{
  "__inputs": [],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(coord_agent_plugin_invocations_total, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "plugin",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(coord_agent_plugin_invocations_total, plugin)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "插件调用速率（按 plugin / outcome）",
      "description": "coord_agent_plugin_invocations_total{plugin,engine,outcome}：JS/wasm 插件 Invoke 吞吐与结果分布。",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (plugin, outcome) (rate(coord_agent_plugin_invocations_total{instance=~\"$instance\", plugin=~\"$plugin\"}[5m]))",
          "legendFormat": "{{plugin}} {{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "插件调用成功率",
      "description": "outcome=\"ok\" 占全部调用的比例（按 plugin）。",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (plugin) (rate(coord_agent_plugin_invocations_total{instance=~\"$instance\", plugin=~\"$plugin\", outcome=\"ok\"}[5m])) / clamp_min(sum by (plugin) (rate(coord_agent_plugin_invocations_total{instance=~\"$instance\", plugin=~\"$plugin\"}[5m])), 0.0001)",
          "legendFormat": "{{plugin}} success ratio"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "沙箱 Trap 速率（按 plugin / reason）",
      "description": "coord_agent_plugin_traps_total{plugin,reason}：reason = fuel | epoch | memory | other（wasm fuel/epoch/内存越界）或 timeout（JS 中断）。",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (plugin, reason) (rate(coord_agent_plugin_traps_total{instance=~\"$instance\", plugin=~\"$plugin\"}[5m]))",
          "legendFormat": "{{plugin}} {{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "插件加载 / 启动失败（1h 增量）",
      "description": "coord_agent_plugin_load_failures_total{plugin}：清单解析 / 实例化 / 启动失败次数（含身份开通失败回退共享客户端不计数）。",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (plugin) (increase(coord_agent_plugin_load_failures_total{instance=~\"$instance\", plugin=~\"$plugin\"}[1h]))",
          "legendFormat": "{{plugin}} load failures"
        }
      ]
    },
    {
      "type": "stat",
      "title": "已加载插件数（有调用记录）",
      "description": "出现过调用计数的插件基数（代理已加载并在服务的插件规模）。",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (plugin) (coord_agent_plugin_invocations_total{instance=~\"$instance\"}))",
          "legendFormat": "plugins"
        }
      ]
    },
    {
      "type": "table",
      "title": "按引擎 / 结果分布（1h 增量）",
      "description": "engine = js | wasm；按引擎与 outcome 汇总近 1 小时调用量。",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (engine, outcome) (increase(coord_agent_plugin_invocations_total{instance=~\"$instance\", plugin=~\"$plugin\"}[1h]))",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "type": "table",
      "title": "Trap 明细（1h 增量）",
      "description": "按 plugin / reason 汇总近 1 小时 trap，用于定位沙箱资源上限或插件缺陷。",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (plugin, reason) (increase(coord_agent_plugin_traps_total{instance=~\"$instance\", plugin=~\"$plugin\"}[1h]))",
          "format": "table",
          "instant": true
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "title": "coord-agent Plugin Engine",
  "uid": "coord-agent-plugin-engine",
  "version": 1
}
