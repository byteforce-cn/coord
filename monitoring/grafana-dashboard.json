{
  "__inputs": [],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(raft_leader_id, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Raft leader / term / apply 进度",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "raft_leader_id{instance=~\"$instance\"}",
          "legendFormat": "leader_id {{instance}}"
        },
        {
          "refId": "B",
          "expr": "raft_commit_index{instance=~\"$instance\"} - raft_applied_index{instance=~\"$instance\"}",
          "legendFormat": "apply lag {{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "gRPC 请求速率（按方法）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(grpc_requests_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "gRPC 错误 / 慢请求",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(grpc_method_errors_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "errors {{method}}"
        },
        {
          "refId": "B",
          "expr": "sum by (method) (rate(grpc_method_slow_requests_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "slow {{method}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Storage 磁盘与 key 数",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "storage_size_bytes{instance=~\"$instance\"}",
          "legendFormat": "size {{instance}}"
        },
        {
          "refId": "B",
          "expr": "storage_keys_total{instance=~\"$instance\"}",
          "legendFormat": "keys {{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Lease / Watch / Apply",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "lease_active_total{instance=~\"$instance\"}",
          "legendFormat": "lease active {{instance}}"
        },
        {
          "refId": "B",
          "expr": "coord_watch_active{instance=~\"$instance\"}",
          "legendFormat": "watch active {{instance}}"
        },
        {
          "refId": "C",
          "expr": "coord_watch_dropped_total{instance=~\"$instance\"}",
          "legendFormat": "watch dropped {{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Txn 冲突率 / Compaction 回收 / Auth 拒绝",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(coord_txn_conflicts_total{instance=~\"$instance\"}[5m]) / clamp_min(rate(coord_txn_total{instance=~\"$instance\"}[5m]), 0.0001)",
          "legendFormat": "txn conflict ratio {{instance}}"
        },
        {
          "refId": "B",
          "expr": "rate(coord_compaction_reclaimed_bytes_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "compaction reclaimed {{instance}}"
        },
        {
          "refId": "C",
          "expr": "rate(coord_auth_denied_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "auth denied {{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Multi-Raft: Region 数据 / Leader / Raft 进度 (per Region)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "coord_region_size_bytes{instance=~\"$instance\"}",
          "legendFormat": "size region {{region_id}}"
        },
        {
          "refId": "B",
          "expr": "coord_region_keys_total{instance=~\"$instance\"}",
          "legendFormat": "keys region {{region_id}}"
        },
        {
          "refId": "C",
          "expr": "coord_region_is_leader{instance=~\"$instance\"}",
          "legendFormat": "leader region {{region_id}}"
        },
        {
          "refId": "D",
          "expr": "coord_region_raft_log_index{instance=~\"$instance\"}",
          "legendFormat": "raft index region {{region_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Multi-Raft: PD operator / 副本 / 节点",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(coord_pd_operator_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "pd operator rate {{instance}}"
        },
        {
          "refId": "B",
          "expr": "coord_pd_operator_total{instance=~\"$instance\"}",
          "legendFormat": "pd operator total {{instance}}"
        },
        {
          "refId": "C",
          "expr": "coord_local_leader_count{instance=~\"$instance\"}",
          "legendFormat": "local leader count {{instance}}"
        },
        {
          "refId": "D",
          "expr": "coord_local_region_count{instance=~\"$instance\"}",
          "legendFormat": "local region count {{instance}}"
        },
        {
          "refId": "E",
          "expr": "coord_regions_total{instance=~\"$instance\"}",
          "legendFormat": "regions total {{instance}}"
        },
        {
          "refId": "F",
          "expr": "coord_nodes_online{instance=~\"$instance\"}",
          "legendFormat": "nodes online {{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "KV-T: TSO / Sequencer",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "coord_tso_batch_remaining{instance=~\"$instance\"}",
          "legendFormat": "tso batch remaining {{instance}}"
        },
        {
          "refId": "B",
          "expr": "rate(coord_tso_refill_failures_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "tso refill failures/s {{instance}}"
        },
        {
          "refId": "C",
          "expr": "rate(coord_tso_leader_changes_total{instance=~\"$instance\"}[10m])",
          "legendFormat": "tso leader changes/s {{instance}}"
        },
        {
          "refId": "D",
          "expr": "rate(coord_kvt_sequencer_txns_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "sequencer txns/s {{instance}}"
        },
        {
          "refId": "E",
          "expr": "rate(coord_kvt_sequencer_conflicts_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "sequencer conflicts/s {{instance}}"
        },
        {
          "refId": "F",
          "expr": "rate(coord_kvt_sequencer_validation_us_total{instance=~\"$instance\"}[5m]) / clamp_min(rate(coord_kvt_sequencer_txns_total{instance=~\"$instance\"}[5m]), 0.001)",
          "legendFormat": "validation us/txn {{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "KV-T: Commit Log / Watch",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "coord_kv_t_commit_watermark{instance=~\"$instance\"}",
          "legendFormat": "commit watermark {{instance}}"
        },
        {
          "refId": "B",
          "expr": "coord_kv_t_commit_in_flight{instance=~\"$instance\"}",
          "legendFormat": "in-flight commits {{instance}}"
        },
        {
          "refId": "C",
          "expr": "rate(coord_kv_t_commit_watermark_stalls_total{instance=~\"$instance\"}[10m])",
          "legendFormat": "watermark stalls/s {{instance}}"
        },
        {
          "refId": "D",
          "expr": "coord_kv_t_commit_log_seal_lag_seconds{instance=~\"$instance\"}",
          "legendFormat": "seal lag s {{instance}}"
        },
        {
          "refId": "E",
          "expr": "coord_kv_t_commit_log_shards{instance=~\"$instance\"}",
          "legendFormat": "shards {{instance}}"
        },
        {
          "refId": "F",
          "expr": "coord_kv_t_commit_log_shards_sealed{instance=~\"$instance\"}",
          "legendFormat": "sealed {{instance}}"
        },
        {
          "refId": "G",
          "expr": "coord_kv_t_watch_lag_commit_ts{instance=~\"$instance\"}",
          "legendFormat": "watch lag (commit_ts) {{instance}}"
        },
        {
          "refId": "H",
          "expr": "rate(coord_kv_t_watch_history_unavailable_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "history unavailable/s {{instance}}"
        }
      ]
    }
    ,
    {
      "type": "timeseries",
      "title": "MQ v2: Publish / Poll",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(coord_mq_v2_publish_requests_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "publish req/s {{instance}}"
        },
        {
          "refId": "B",
          "expr": "rate(coord_mq_v2_publish_entries_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "publish entries/s {{instance}}"
        },
        {
          "refId": "C",
          "expr": "rate(coord_mq_v2_publish_bytes_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "publish bytes/s {{instance}}"
        },
        {
          "refId": "D",
          "expr": "rate(coord_mq_v2_publish_latency_us_total{instance=~\"$instance\"}[1m]) / clamp_min(rate(coord_mq_v2_publish_requests_total{instance=~\"$instance\"}[1m]), 0.001) / 1000",
          "legendFormat": "publish avg ms {{instance}}"
        },
        {
          "refId": "E",
          "expr": "rate(coord_mq_v2_poll_requests_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "poll req/s {{instance}}"
        },
        {
          "refId": "F",
          "expr": "rate(coord_mq_v2_poll_messages_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "poll messages/s {{instance}}"
        },
        {
          "refId": "G",
          "expr": "rate(coord_mq_v2_poll_empty_total{instance=~\"$instance\"}[1m]) / clamp_min(rate(coord_mq_v2_poll_requests_total{instance=~\"$instance\"}[1m]), 0.001)",
          "legendFormat": "poll empty ratio {{instance}}"
        },
        {
          "refId": "H",
          "expr": "rate(coord_mq_v2_poll_out_of_range_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "poll out-of-range/s {{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "MQ v2: Groups / DLQ / Retention",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(coord_mq_v2_group_joins_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "group joins/s {{instance}}"
        },
        {
          "refId": "B",
          "expr": "rate(coord_mq_v2_group_rebalances_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "group rebalances/s {{instance}}"
        },
        {
          "refId": "C",
          "expr": "rate(coord_mq_v2_group_expired_members_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "expired members/s {{instance}}"
        },
        {
          "refId": "D",
          "expr": "rate(coord_mq_v2_group_gc_removed_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "groups gc-removed/s {{instance}}"
        },
        {
          "refId": "E",
          "expr": "rate(coord_mq_v2_dlq_moved_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "dlq moved/s {{instance}}"
        },
        {
          "refId": "F",
          "expr": "rate(coord_mq_v2_poll_dlq_messages_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "dlq polled/s {{instance}}"
        },
        {
          "refId": "G",
          "expr": "rate(coord_mq_v2_retention_truncate_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "retention truncates/s {{instance}}"
        },
        {
          "refId": "H",
          "expr": "rate(coord_mq_v2_retention_segments_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "retention segments/s {{instance}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "title": "coord-server Overview",
  "uid": "coord-server-overview",
  "version": 2
}
