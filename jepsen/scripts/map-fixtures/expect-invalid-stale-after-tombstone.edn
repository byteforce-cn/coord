;; expect-invalid-stale-after-tombstone —— §5.1 的专属断言
;; 「tombstone 之后读旧值 = 0」被违反：delete 在 t=20 确认生效
;; （invoke 15），而 t=30 的读仍然返回被删掉的旧值 v1。
;; 判定依据（windex 强制序）：t=30 的读开始前，delete（invoke 15 >
;; 写 v1 的完成时间 10）已被强制排在该读之前 ⇒ 值必须是 nil。
[{:type :ok, :f :write,  :process 0, :key "/jepsen/map/k0", :invoke 5,  :time 10
  :value "v1"}
 {:type :ok, :f :delete, :process 0, :key "/jepsen/map/k0", :invoke 15, :time 20
  :value nil, :deleted 1, :prev-kv-requested? true
  :prev-kvs [{:key "/jepsen/map/k0", :value "v1", :version 1}]}
 {:type :ok, :f :read,   :process 0, :key "/jepsen/map/k0", :invoke 25, :time 30
  :value "v1"}]
