;; expect-valid-clean —— T1.1 的基线正例。
;; 写 → 读（看到新值）→ 删（tombstone）→ 读（不存在）。
;; 关键：删之后读 nil 是**合法**的（nil 生产者 = 那条 delete），
;; 所以这条 fixture 同时是「不许误报 nil」的守门员。
[{:type :ok, :f :write, :process 0, :key "/jepsen/map/k0", :invoke 5,  :time 10
  :value "v1"}
 {:type :ok, :f :read,  :process 0, :key "/jepsen/map/k0", :invoke 15, :time 20
  :value "v1"}
 {:type :ok, :f :delete, :process 0, :key "/jepsen/map/k0", :invoke 25, :time 30
  :value nil, :deleted 1, :prev-kv-requested? true
  :prev-kvs [{:key "/jepsen/map/k0", :value "v1", :version 1}]}
 {:type :ok, :f :read,  :process 0, :key "/jepsen/map/k0", :invoke 35, :time 40
  :value nil}
 {:type :ok, :f :exists, :process 0, :key "/jepsen/map/k0", :invoke 45, :time 50
  :exists? false}]
