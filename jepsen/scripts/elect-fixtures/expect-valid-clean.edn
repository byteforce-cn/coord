;; expect-valid-clean —— M5a election 基线：两个 candidate 顺序当选、都 Resign 了。
;;
;; 判定口径（jepsen.coord.electck）：
;;   * 同一 group 上两个不同 candidate 的**已闭合** leader 区间不得重叠
;;     （未 Resign 的区间不参与，见 expect-valid-unclosed-interval）；
;;   * Resign 成功后 GetLeader 不得再返回自己。
[{:type :ok :f :elect-campaign :process 0 :time 10
  :elected? true :group-name "g1" :candidate-id "c1" :lease-id 21
  :campaign-at-ms 10 :resigned-at-ms 800 :resigned? true
  :gone? true :gone-at-ms 800 :still-leader-after-resign false
  :holder-ttl-seconds 10
  :leader-after-resign {:leader-id "" :exists false}}

 {:type :ok :f :elect-campaign :process 1 :time 20
  :elected? true :group-name "g1" :candidate-id "c2" :lease-id 22
  :campaign-at-ms 1000 :resigned-at-ms 1800 :resigned? true
  :gone? true :gone-at-ms 1800 :still-leader-after-resign false
  :holder-ttl-seconds 10
  :leader-after-resign {:leader-id "" :exists false}}]
