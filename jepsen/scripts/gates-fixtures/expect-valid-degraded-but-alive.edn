 {:type :info, :process 1, :f :write, :value 6, :time 12, :error :timeout}
 {:type :invoke, :process 1, :f :write, :value 7, :time 13}
 {:type :info, :process 1, :f :write, :value 7, :time 14, :error :timeout}
