;; expect-valid-clean —— T1.2 基线正例：四种 txn 形态各一条，全部合法。
;;   * :txn-create 全 新 key 上 succeeded=true，回读看到写入的值；
;;   * :txn-write-set 三个 key 全部可见（区间回读）；
;;   * :txn-cas-delete 失败分支执行（回读看不到 key），成功分支的值没有被观察到；
;;   * :txn-read 读到当前值。
[{:type :ok, :f :txn-create, :process 0, :invoke 10, :time 20
  :value {:key "/jepsen/txn/s42-create-1" :val "1"}
  :succeeded true
  :wrote {"/jepsen/txn/s42-create-1" "1"}
  :success-wrote {"/jepsen/txn/s42-create-1" "1"}
  :failure-wrote {}
  :wrote-possible {"/jepsen/txn/s42-create-1" "1"}
  :setup-ok? true
  :post-read {:kv {:key "/jepsen/txn/s42-create-1" :value "1"}}
  :post-read-ok? true
  :response-count 1}
 {:type :ok, :f :txn-write-set, :process 0, :invoke 30, :time 40
  :value {:prefix "/jepsen/txn/s42-set-2/" :vals ["2-a" "2-b" "2-c"]
          :range-start "/jepsen/txn/s42-set-2/" :range-end "/jepsen/txn/s42-set-2/z"}
  :succeeded true
  :wrote {"/jepsen/txn/s42-set-2/0" "2-a"
          "/jepsen/txn/s42-set-2/1" "2-b"
          "/jepsen/txn/s42-set-2/2" "2-c"}
  :success-wrote {"/jepsen/txn/s42-set-2/0" "2-a"
                  "/jepsen/txn/s42-set-2/1" "2-b"
                  "/jepsen/txn/s42-set-2/2" "2-c"}
  :failure-wrote {}
  :setup-ok? true
  :post-read {:kvs [{:key "/jepsen/txn/s42-set-2/0" :value "2-a"}
                    {:key "/jepsen/txn/s42-set-2/1" :value "2-b"}
                    {:key "/jepsen/txn/s42-set-2/2" :value "2-c"}]}
  :post-read-ok? true
  :response-count 3}
 {:type :ok, :f :txn-cas-delete, :process 0, :invoke 50, :time 60
  :value {:key "/jepsen/txn/s42-casd-3" :old "old-3" :val "new-3"}
  :succeeded false
  :wrote {"/jepsen/txn/s42-casd-3" nil}
  :success-wrote {"/jepsen/txn/s42-casd-3" "new-3"}
  :failure-wrote {"/jepsen/txn/s42-casd-3" nil}
  :wrote-possible {"/jepsen/txn/s42-casd-3" nil}
  :setup {:key "/jepsen/txn/s42-casd-3" :value "old-3"}
  :setup-ok? true
  :post-read {:kv nil}
  :post-read-ok? true
  :response-count 1}
 {:type :ok, :f :txn-read, :process 0, :key "/jepsen/txn/s42-create-1", :invoke 70, :time 80
  :value "1"
  :kv {:key "/jepsen/txn/s42-create-1" :value "1"}}]
