  :value "w2" :revision 11}
 {:type :ok :f :write :process 0 :key "/jepsen/watch/s42" :invoke 5 :time 6
  :value "w3" :revision 12}
 {:type :ok :f :watch-session :process 0 :invoke 7 :time 30
  :key "/jepsen/watch/s42"
  :value {:key "/jepsen/watch/s42" :start-revision 0}
  :start-revision 0
  :end-revision 12
  :events [{:type :put :revision 10 :kvs [{:key "/jepsen/watch/s42" :value "w1"}]}
           {:type :put :revision 12 :kvs [{:key "/jepsen/watch/s42" :value "w3"}]}]}]
