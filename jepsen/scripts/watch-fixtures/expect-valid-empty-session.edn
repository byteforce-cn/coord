;; expect-valid-empty-session —— F-21 的守门员：**一个事件都没收到的会话**不得被判
;; 「丢事件」。这种会话的 `:events` 为空、`start-revision` 为正（resume 起点），
;; 覆盖区间上界**只能从事件自推**（没有事件 ⇒ 没有区间）。客户端曾经把
;; `:end-revision` 汇报成「最后一次尝试的起点」（重绑定的循环变量），于是
;; (start, start+2] 里的所有确认写都被判成丢失 —— 一条看着像被测系统违约的假红。
[{:type :ok :f :write :process 0 :key "/jepsen/watch/s42" :invoke 1 :time 2
  :value "w1" :revision 100}
 {:type :ok :f :write :process 0 :key "/jepsen/watch/s42" :invoke 3 :time 4
  :value "w2" :revision 101}
 {:type :ok :f :write :process 0 :key "/jepsen/watch/s42" :invoke 5 :time 6
  :value "w3" :revision 102}
 ;; 正常会话：覆盖 (100, 102]，两个确认写都在 ⇒ 无缺口
 {:type :ok :f :watch-session :process 0 :invoke 7 :time 30
  :key "/jepsen/watch/s42"
  :value {:key "/jepsen/watch/s42" :start-revision 0}
  :start-revision 0
  :end-revision 102
  :events [{:type :put :revision 101 :kvs [{:key "/jepsen/watch/s42" :value "w2"}]}
           {:type :put :revision 102 :kvs [{:key "/jepsen/watch/s42" :value "w3"}]}]}
 ;; 空会话（三次尝试都没建起流）：不得判丢失
 {:type :ok :f :watch-session :process 0 :invoke 8 :time 40
  :key "/jepsen/watch/s42"
  :value {:key "/jepsen/watch/s42" :start-revision :last}
  :start-revision 102
  :end-revision nil
  :events []
  :resumes 2
  :stream-errors [["n1" "UNAVAILABLE: io exception"] ["n1" "UNAVAILABLE: io exception"]]
  :sessions [{:node "n1" :start-revision 102 :events [] :end-revision 102
              :error "UNAVAILABLE: io exception"}
             {:node "n1" :start-revision 103 :events [] :end-revision 103
              :error "UNAVAILABLE: io exception"}
             {:node "n1" :start-revision 104 :events [] :end-revision 104
              :error "UNAVAILABLE: io exception"}]}]
