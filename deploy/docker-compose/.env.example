# coord 集群共享密钥（三节点必须一致，填写后 docker compose up -d）
#
# 注意：
#   - 不要提交真实密钥进仓库；生产建议使用外部 secret 管理；
#   - __FILL_*__ 占位值无法通过启动校验（R-SEC-04），未填写时集群拒绝启动；
#   - AUTH_ROOT_KEY / RAFT_SHARED_SECRET 在容器启动时替换进 conf/*.toml 模板，
#     建议用 hex 字符生成（与模板替换安全兼容）。

# 登录 root 密码（首次引导使用；若留空，随机生成并仅打印一次）
ROOT_PASSWORD=__FILL_ROOT_PASSWORD__

# CCT 签发根密钥（hex 64 字符 = 32 字节，三节点一致）；生成：openssl rand -hex 32
AUTH_ROOT_KEY=__FILL_AUTH_ROOT_KEY__

# raft 端口共享密钥（R-SEC-03 HMAC 认证，≥16 字符，三节点一致）；生成：openssl rand -hex 32
RAFT_SHARED_SECRET=__FILL_RAFT_SHARED_SECRET__

# 传输层 TLS（compose 已默认开启 gRPC + raft mTLS）：
# 首次启动前先运行 ./certs/gen-certs.sh 生成 ca/server/agent 证书（挂载到 /etc/coord/tls）；
# 缺失时集群拒绝启动（fail-closed）。客户端（coord-agent）需用同一 CA 签发的 agent.crt/agent.key。
